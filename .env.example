# Vite exposes only VITE_* to the client. Publishable/anon key only — never the service role.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# Optional: public demo URL after Cloudflare Pages deploy (for docs / QR)
# VITE_PUBLIC_DEMO_URL=https://YOUR_PROJECT.pages.dev

# --- Role B env checklist (Supabase Dashboard) ---
# [ ] Auth → Providers → Email ON
# [ ] Auth → Confirm email OFF for demo (re-enable before public pilot)
# [ ] SQL: init_schema → ideas_lat_lng → PASTE_ME_storage → PASTE_ME_spatial → PASTE_ME_fault_history
# [ ] Auth users: autor@example.com + sasiad@example.com
# [ ] SQL seed: demo_fake_profiles.sql → demo_scenario.sql
# [ ] Storage bucket for photos if used
# [ ] (Opcjonalnie) supabase functions deploy generate-application
# [ ] (Na końcu) supabase secrets set OPENAI_API_KEY=...  — NIE wklejaj do VITE_*
