# Vite exposes only VITE_* to the client. Publishable/anon key only — never the service role.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# --- Role B env checklist (Supabase Dashboard) ---
# [ ] Auth → Providers → Email ON
# [ ] Auth → Confirm email OFF for demo (re-enable before public pilot)
# [ ] SQL: migrations + PASTE_ME_storage_notifications.sql + PASTE_ME_spatial_likers.sql
# [ ] SQL seed: demo_fake_profiles.sql → demo_scenario.sql (after autor/sasiad accounts)
# [ ] Storage bucket idea-photos (public read) if using photos
# [ ] Edge Function generate-application optional; mock works without OPENAI_API_KEY
